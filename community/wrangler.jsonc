{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neverjustsell-community",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neverjustsell-community",
      "database_id": "c12fc8da-0de7-4ca0-92e9-1fd2cf358f15"
    }
  ],
  "services": [
    {
      "binding": "AUTH_BRIDGE",
      "service": "neverjustsell-course-access"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://community.neverjustsell.com",
    "AUTH_BRIDGE_ORIGIN": "https://classroom.neverjustsell.com"
  }
}
