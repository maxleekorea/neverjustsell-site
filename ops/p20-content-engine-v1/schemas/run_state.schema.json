{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P20 Gate-Enforced Run State",
  "type": "object",
  "additionalProperties": true,
  "required": ["engine", "engine_version", "content_id", "topic", "production_type", "persistent_draft", "gates"],
  "properties": {
    "engine": {"const": "P20_CONTENT_ENGINE_V1"},
    "engine_version": {"type": "string"},
    "content_id": {"type": "string"},
    "topic": {"type": "string"},
    "one_shot_full_draft_allowed": {"const": false},
    "persistent_draft": {"const": "14_script.md"},
    "production_type": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"enum": ["A", "B", "C", "D", "E", "F", "G"]},
        "secondary": {"type": ["string", "null"]}
      }
    },
    "gates": {"type": "object"}
  }
}
