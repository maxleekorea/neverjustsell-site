{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"P20 Script Evaluation",
  "type":"object",
  "additionalProperties":false,
  "required":["eligibility","dimensions","source_violations","return_gate","summary"],
  "properties":{
    "eligibility":{"type":"string","enum":["PASS","HOLD"]},
    "dimensions":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["name","score","evidence","issue"],
        "properties":{
          "name":{"type":"string"},
          "score":{"type":"number","minimum":1,"maximum":5},
          "evidence":{"type":"string"},
          "issue":{"type":"string"}
        }
      }
    },
    "source_violations":{"type":"array","items":{"type":"string"}},
    "return_gate":{"type":"string"},
    "summary":{"type":"string"}
  }
}
