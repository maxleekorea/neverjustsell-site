{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neverjustsell-course-access",
  "main": "src/entrypoint.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "classroom.neverjustsell.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CAFE24_AUTH"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://www.neverjustsell.com",
    "CAFE24_REDIRECT_URI": "https://classroom.neverjustsell.com/oauth/cafe24/callback",
    "COMMUNITY_ALLOWED_ORIGINS": "https://community.neverjustsell.com"
  },
  "d1_databases": [
    {
      "binding": "COURSE_DB",
      "database_name": "neverjustsell-courses",
      "database_id": "be6afae6-e115-4229-9cdb-b4f91cc28036"
    }
  ]
}
