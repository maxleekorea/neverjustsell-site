{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neverjustsell-site",
  "main": "src/runtime.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "www.neverjustsell.com",
      "custom_domain": true
    },
    {
      "pattern": "neverjustsell.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://www.neverjustsell.com",
    "AUTH_ORIGIN": "https://classroom.neverjustsell.com",
    "COMMUNITY_ORIGIN": "https://community.neverjustsell.com",
    "SHOP_ORIGIN": "https://neverjustsell.cafe24.com"
  }
}
